# Copy to backend/.env and fill in. Never commit the real .env.

# Required: any long random string. The server refuses to start without it.
# Changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

MONGODB_URI=mongodb://localhost:27017/cab-booking

# The site(s) allowed to call this API, comma-separated, no trailing slash.
CLIENT_URL=http://localhost:5173

PORT=5000

# Only set this to true when you deliberately want POST /api/content/seed to
# replace every place and package with the starter content. Leave it off otherwise.
ALLOW_CONTENT_SEED=false
